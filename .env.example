# AgentWatch Web — Environment Configuration
# Copy this file to .env.local and fill in your values.

# Database Connection (Neon PostgreSQL string, or local PostgreSQL/SQLite)
DATABASE_URL="postgresql://user:password@ep-xyz.neon.tech/agentwatch?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-xyz.neon.tech/agentwatch?sslmode=require"

# Gemini API Key — https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Collector Shared Authentication Token
COLLECTOR_API_TOKEN=agentwatch-collector-token-dev

# Optional: Public API URL override if deployed on custom domain
# NEXT_PUBLIC_API_URL=https://your-agentwatch.vercel.app/api
